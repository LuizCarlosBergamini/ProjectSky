    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 6621452ba489c924796fd9fe71c93adf, type: 2}
  - dialogId: daisy-kitsunederrota-02
    dialogContent: "Provavelmente. Mas lembra: a Medusa e a Kitsune voltam pras arenas."
