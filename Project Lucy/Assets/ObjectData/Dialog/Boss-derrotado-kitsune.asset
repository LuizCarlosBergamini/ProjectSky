    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: daisy-kitsunederrota-03
    dialogContent: "Enfrenta elas de novo, junta Engrenagens de Ouro e deixa o Mec\xE2nico te preparar. S\xF3 segue quando se sentir pronta!"
