  - dialogId: daisy-02
    dialogContent: "Acho que esse seu grappling hook realmente faz diferen\xE7a."
    nextDialog: jogador-01
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: jogador-01
