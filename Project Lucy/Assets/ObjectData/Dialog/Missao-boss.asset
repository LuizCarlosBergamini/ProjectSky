    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 6621452ba489c924796fd9fe71c93adf, type: 2}
  - dialogId: daisy-boss-02
    dialogContent: "Ele protege a sa\xEDda da caverna. Derrote ele e eu te dou uma
      recompensa!"
    nextDialog: daisy-boss-03
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: daisy-boss-03
    dialogContent: "Eu n\xE3o sou muito boa de briga, ent\xE3o vou voltar e te esperar
      no Hub. Boa sorte!"
