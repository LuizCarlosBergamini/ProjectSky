    nextDialog: lucy-boss-01
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: lucy-boss-01
    dialogContent: "Guardi\xE3o? Ningu\xE9m me falou nada sobre um guardi\xE3o..."
