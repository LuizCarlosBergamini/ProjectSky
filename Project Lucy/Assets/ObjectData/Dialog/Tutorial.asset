%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0229f9af6181a38469057567674f0751, type: 3}
  m_Name: Tutorial
  m_EditorClassIdentifier: 
  dialogs:
  - dialogId: daisy-inicio-01
    dialogContent: "Ei, voc\xEA!"
    nextDialog: lucy-inicio-01
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: lucy-inicio-01
    dialogContent: "... Quem \xE9 voc\xEA? Onde estou?"
    nextDialog: daisy-inicio-02
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 6621452ba489c924796fd9fe71c93adf, type: 2}
  - dialogId: daisy-inicio-02
    dialogContent: "Eu sou a Daisy Macabell, e esse \xE9 o Wallace Macabell, meu
      irm\xE3o. Te encontramos ca\xEDda aqui e queremos te ajudar a consertar suas
      pe\xE7as."
    nextDialog: daisy-inicio-02b
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: daisy-inicio-02b
    dialogContent: Bom, eu vou te ajudar; o Wallace provavelmente vai continuar escrevendo
      sua poesia estranha...
    nextDialog: wallace-inicio-01
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: wallace-inicio-01
    dialogContent: "Ei, pelo menos n\xE3o sujo minhas m\xE3os de graxa!"
    nextDialog: daisy-inicio-03
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 1d7e921bde50cdb4a955a7e9536defb4, type: 2}
  - dialogId: daisy-inicio-03
    dialogContent: "Mas... Qual \xE9 o seu nome? Como veio parar aqui?"
    nextDialog: lucy-inicio-02
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: lucy-inicio-02
    dialogContent: "N\xE3o me lembro muito bem de nada... est\xE1 tudo t\xE3o confuso...
      acho que me chamo... Lucy! Lembro vagamente de um homem me dando esse nome..."
    nextDialog: daisy-inicio-04
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 6621452ba489c924796fd9fe71c93adf, type: 2}
  - dialogId: daisy-inicio-04
    dialogContent: "Bom, Lucy, n\xF3s vamos te ajudar. Para isso, deixe-me explicar
      como as coisas funcionam aqui."
    nextDialog: daisy-inicio-05
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: daisy-inicio-05
    dialogContent: "Voc\xEA pode se mover para os lados usando 'A' e 'D'; para pular,
      use 'W' ou 'espa\xE7o'. Quando encontrar inimigos, use o 'bot\xE3o esquerdo
      do mouse' para atacar."
    nextDialog: daisy-inicio-06
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: daisy-inicio-06
    dialogContent: "Ah! Al\xE9m disso, para usar seu agarrador e pendurar-se em blocos
      de apoio, segure o 'bot\xE3o direito do mouse'; o 'espa\xE7o' pode te dar um
      impulso na hora de soltar."
    nextDialog: wallace-inicio-02
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: wallace-inicio-02
    dialogContent: "Do outro lado da passagem \xE0 frente, voc\xEA encontrar\xE1
      inimigos desafiadores. Fique firme; a Daisy estar\xE1 l\xE1 para te ajudar."
    nextDialog: daisy-inicio-07
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 1d7e921bde50cdb4a955a7e9536defb4, type: 2}
  - dialogId: daisy-inicio-07
    dialogContent: "Agora \xE9 com voc\xEA. Cruze a passagem usando o agarrador.
      Te encontro do outro lado. Boa sorte!"
    nextDialog: 
    triggerEvent: tutorial-iniciado
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
