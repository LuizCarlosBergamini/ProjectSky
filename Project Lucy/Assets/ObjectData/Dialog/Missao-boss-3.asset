MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0229f9af6181a38469057567674f0751, type: 3}
  m_Name: Missao-boss-3
  m_EditorClassIdentifier: Assembly-CSharp::Dialog_SO
  dialogs:
  - dialogId: daisy-boss3-01
    dialogContent: "Lucy, espera! H\xE1 uma magia muito forte na arena \xE0 frente..."
    nextDialog: lucy-boss3-01
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: lucy-boss3-01
    dialogContent: "Mais um inimigo? Depois da Medusa e de Kitsune, j\xE1 estou pronta
      para qualquer coisa."
    nextDialog: daisy-boss3-02
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 6621452ba489c924796fd9fe71c93adf, type: 2}
  - dialogId: daisy-boss3-02
    dialogContent: "Dessa vez \xE9 diferente... Wallace diz que \xE9 prov\xE1vel
      que o guardi\xE3o desta magia tenha invocado os outros inimigos. Assim, ele
      lembrou-se do Mago que defende esse lugar."
    nextDialog: daisy-boss3-03
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: daisy-boss3-03
    dialogContent: "O Mago ataca de longe, com flechas e esferas de magia. Ele n\xE3o
      gosta de apanhar: depois de alguns golpes, recua de repente! N\xE3o deixe-o
      escapar."
    nextDialog: daisy-boss3-04
    triggerEvent: 
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
  - dialogId: daisy-boss3-04
    dialogContent: "Derrote-o para receber a recompensa e avan\xE7ar, mas seja muito
      cuidadosa. Te espero do outro lado."
    nextDialog: 
    triggerEvent: missao-boss-3-iniciada
    dialogDuration: 0
    dialogOptions: []
    dialogEntity: {fileID: 11400000, guid: 48252c5877aa26d4da3cbd6950ce2808, type: 2}
